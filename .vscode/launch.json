{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Track Video",
            "type": "debugpy",
            "request": "launch",
            "module": "human_detection.main",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "input=video",
                "input.name=walking_outdoor_clothes_change_60s",
                "target.name=walking_outdoor_clothes_change_60s"
            ]
        },
        {
            "name": "Track Camera",
            "type": "debugpy",
            "request": "launch",
            "module": "human_detection.main",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "input=camera",
                "target.name=walking_outdoor_clothes_change_60s"
            ]
        }
    ]
}
